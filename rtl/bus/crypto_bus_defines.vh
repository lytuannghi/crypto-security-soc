`ifndef CRYPTO_BUS_DEFINES_VH
`define CRYPTO_BUS_DEFINES_VH

`define ADDR_ROM_BASE     32'h0000_0000
`define ADDR_SRAM_BASE    32'h1000_0000
`define ADDR_AES_BASE     32'h2000_0000
`define ADDR_SHA_BASE     32'h3000_0000
`define ADDR_TRNG_BASE    32'h4000_0000
`define ADDR_TAMPER_BASE  32'h5000_0000
`define ADDR_UART_BASE    32'h6000_0000
`define ADDR_TIMER_BASE   32'h7000_0000

`endif // CRYPTO_BUS_DEFINES_VH
